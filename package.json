{
  "name": "claim-gate-autopilot",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test --test-reporter=spec test/unit/*.test.ts test/integration/*.test.ts test/attack-matrix.test.ts test/ci-integrity.test.ts test/benchmark.test.ts",
    "test:unit": "node --experimental-strip-types --test test/unit/*.test.ts",
    "test:integration": "node --experimental-strip-types --test test/integration/*.test.ts",
    "test:matrix": "node --experimental-strip-types --test test/attack-matrix.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint.mjs",
    "scan": "node scripts/scan.mjs",
    "build": "node --experimental-strip-types -e \"import('./src/cli.ts').then((m) => console.log(typeof m.main))\""
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "typescript": "5.7.3"
  }
}
